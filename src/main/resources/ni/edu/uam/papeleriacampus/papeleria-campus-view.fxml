<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="750.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.papeleriacampus.controller.PapeleriaCampusController">
   <children>
      <VBox alignment="CENTER" layoutX="10.0" layoutY="14.0" prefHeight="720.0" prefWidth="580.0" spacing="10.0">
         <children>
            <Label text="Registro Productos">
               <font>
                  <Font name="Times New Roman Bold" size="18.0" />
               </font>
            </Label>
            <Separator prefWidth="200.0" />
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="285.0" minWidth="10.0" prefWidth="147.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="433.0" minWidth="10.0" prefWidth="433.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Código:">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Nombre:" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Categoría:" GridPane.rowIndex="2">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Precio:" GridPane.rowIndex="3">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Stock:" GridPane.rowIndex="4">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCodigo" promptText="Ej: P001" GridPane.columnIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
                  <TextField fx:id="txtNombre" promptText="Ej: Computadora portatil" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
                  <ComboBox fx:id="cmbCategoria" prefHeight="26.0" prefWidth="291.0" promptText="Seleccione una categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
                  <TextField fx:id="txtStock" promptText="Ej: 15" GridPane.columnIndex="1" GridPane.rowIndex="4">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
               </children>
            </GridPane>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="33.0" prefWidth="580.0" spacing="15.0">
               <children>
                  <Button fx:id="btnLimpiarFormulario" mnemonicParsing="false" onAction="#limpiarFormulario" style="-fx-background-color: #7DF900;" text="Limpiar Formulario">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarProducto" style="-fx-background-color: #001BFA;" text="Guardar" textFill="WHITE">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarProducto" style="-fx-background-color: #FAE500;" text="Actualizar">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" style="-fx-background-color: #D70016;" text="Eliminar" textFill="WHITE">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <Label text="Búsqueda y Filtros">
               <font>
                  <Font name="Times New Roman Bold" size="18.0" />
               </font></Label>
            <Separator prefWidth="200.0" />
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="285.0" minWidth="10.0" prefWidth="147.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="433.0" minWidth="10.0" prefWidth="433.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="Código:">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></Label>
                  <Label text="Nombre:" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></Label>
                  <Label text="Categoría:" GridPane.rowIndex="2">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></Label>
                  <Label text="Precio:" GridPane.rowIndex="3">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></Label>
                  <ComboBox fx:id="cmbCategoriaFiltro" prefHeight="26.0" prefWidth="291.0" promptText="Seleccione una categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="txtCodigoFiltro" promptText="Ingrese el código del producto" GridPane.columnIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
                  <TextField fx:id="txtNombreFiltro" promptText="Ingrese el nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
                  <TextField fx:id="txtPrecioFiltro" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <font>
                        <Font name="Times New Roman" size="14.0" />
                     </font></TextField>
               </children>
            </GridPane>
            <CheckBox fx:id="chkExistencia" mnemonicParsing="false" onAction="#filtrarExistencia" text="Solo con existencias">
               <font>
                  <Font name="Times New Roman" size="14.0" />
               </font></CheckBox>
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER" prefHeight="35.0" prefWidth="580.0" spacing="15.0">
               <children>
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProducto" style="-fx-background-color: #FA8A2C;" text="Buscar">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font></Button>
                  <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" onAction="#limpiarFiltros" style="-fx-background-color: #49FAB4;" text="Limpiar Filtros">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font></Button>
                  <Button fx:id="btnRecargar" mnemonicParsing="false" onAction="#recargarRegistros" style="-fx-background-color: #8100FA;" text="Recargar" textFill="WHITE">
                     <font>
                        <Font name="Times New Roman Bold" size="14.0" />
                     </font></Button>
               </children>
            </HBox>
            <Separator prefWidth="200.0" />
            <Label text="Listado de Productos">
               <font>
                  <Font name="Times New Roman Bold" size="18.0" />
               </font></Label>
            <Separator prefWidth="200.0" />
            <TableView fx:id="tblProductos" prefHeight="142.0" prefWidth="580.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Código" />
                  <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
                  <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoría" />
                  <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
                  <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
